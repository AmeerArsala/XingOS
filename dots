#!/usr/bin/env bash
# dots - snapshot live config into this repo, commit, optionally push.
#   dots [sync] [-m MSG] [-p|-n]   copy live files -> repo, commit, offer to push (-p push, -n never)
#   dots status                    show what differs between live files and the repo
#   dots apply [--system]          copy repo -> live files (differing files are backed up first)
#   dots add PATH                  track a new path (relative to $HOME, or absolute for system files)
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
MANIFEST="$REPO/manifest"
HOME_DIR="$REPO/home"
SYS_DIR="$REPO/system"

entries=() excludes=()
while IFS= read -r line; do
    line="${line%%#*}"; line="${line//[$'\t\r ']/}"
    [[ -z "$line" ]] && continue
    if [[ "$line" == !* ]]; then excludes+=("--exclude=${line#!}"); else entries+=("$line"); fi
done < "$MANIFEST"

# live path / repo path for a manifest entry
live_of() { [[ "$1" == /* ]] && echo "$1" || echo "$HOME/$1"; }
repo_of() { [[ "$1" == /* ]] && echo "$SYS_DIR$1" || echo "$HOME_DIR/$1"; }

# copy src -> dst (file or dir), mirroring deletions for dirs
copy() {
    local src="$1" dst="$2"
    if [[ -d "$src" ]]; then
        mkdir -p "$dst"; rsync -a --delete "${excludes[@]}" "$src/" "$dst/"
    else
        mkdir -p "$(dirname "$dst")"; rsync -a "$src" "$dst"
    fi
}

cmd_sync() {
    local msg="" push=ask
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m) msg="$2"; shift 2 ;;
            -p) push=yes; shift ;;
            -n) push=no; shift ;;
            *) echo "unknown option: $1" >&2; exit 2 ;;
        esac
    done

    for e in "${entries[@]}"; do
        live="$(live_of "$e")"; repo="$(repo_of "$e")"
        if [[ -e "$live" ]]; then
            copy "$live" "$repo" 2>/dev/null || echo "warn: could not read $live" >&2
        elif [[ -e "$repo" ]]; then
            echo "note: $live is gone; removing it from the repo"; rm -rf "$repo"
        else
            echo "warn: $e does not exist, skipping" >&2
        fi
    done

    cd "$REPO"
    git add -A
    if git diff --cached --quiet; then echo "Nothing changed."; return; fi
    git status --short
    git commit -q -m "${msg:-sync: $(date '+%Y-%m-%d %H:%M') on $(hostname)}"
    echo "Committed: $(git log -1 --format='%h %s')"

    if [[ -z "$(git remote)" ]]; then
        echo "No remote set. Add one with: git -C $REPO remote add origin <url>"
        return
    fi
    case "$push" in
        no) return ;;
        yes) ;;
        ask) read -r -p "Push to $(git remote | head -1)? [y/N] " a; [[ "$a" =~ ^[Yy]$ ]] || return ;;
    esac
    git push -u "$(git remote | head -1)" HEAD
}

cmd_status() {
    local changed=0
    for e in "${entries[@]}"; do
        live="$(live_of "$e")"; repo="$(repo_of "$e")"
        [[ -e "$live" ]] || { echo "missing live: $e"; changed=1; continue; }
        [[ -e "$repo" ]] || { echo "new (not in repo yet): $e"; changed=1; continue; }
        if [[ -d "$live" ]]; then
            out="$(rsync -rcn --delete --itemize-changes "${excludes[@]}" "$live/" "$repo/" 2>&1 || true)"
        else
            out="$(rsync -cn --itemize-changes "$live" "$repo" 2>&1 || true)"
        fi
        [[ -n "$out" ]] && { echo "== $e"; echo "$out"; changed=1; }
    done
    [[ $changed -eq 0 ]] && echo "Live files match the repo."
    return 0
}

cmd_apply() {
    local system=0; [[ "${1:-}" == "--system" ]] && system=1
    local bk="$HOME/.dots-backup/$(date +%Y%m%d-%H%M%S)"
    for e in "${entries[@]}"; do
        live="$(live_of "$e")"; repo="$(repo_of "$e")"
        [[ -e "$repo" ]] || continue
        if [[ "$e" == /* ]]; then
            if [[ $system -eq 1 ]]; then
                sudo mkdir -p "$(dirname "$live")"
                [[ -e "$live" ]] && sudo cp -a "$live" "$live.dots.bak"
                sudo cp "$repo" "$live"; echo "applied (sudo): $live"
            else
                echo "skipped system file $live (rerun with --system)"
            fi
            continue
        fi
        if [[ -e "$live" ]]; then
            mkdir -p "$bk/$(dirname "$e")"; cp -a "$live" "$bk/$(dirname "$e")/"
        fi
        copy "$repo" "$live"; echo "applied: $e"
    done
    [[ -d "$bk" ]] && echo "Previous versions backed up in $bk"
    # oh-my-zsh is upstream code, not vendored here: .zshrc is tracked, the framework is cloned on demand
    if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
        echo "Installing oh-my-zsh..."
        git clone -q --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
    fi
    if [[ ! -e "$HOME/.local/bin/dots" || ! -L "$HOME/.local/bin/dots" ]]; then
        mkdir -p "$HOME/.local/bin"; ln -sf "$REPO/dots" "$HOME/.local/bin/dots"
    fi
}

cmd_add() {
    [[ -n "${1:-}" ]] || { echo "usage: dots add PATH" >&2; exit 2; }
    p="${1/#$HOME\//}"
    [[ -e "$(live_of "$p")" ]] || { echo "no such path: $1" >&2; exit 1; }
    grep -qxF "$p" "$MANIFEST" && { echo "already tracked: $p"; exit 0; }
    sed -i "/^!/i $p" "$MANIFEST" 2>/dev/null || echo "$p" >> "$MANIFEST"
    echo "tracking: $p"
}

sub=sync
if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then sub=help; shift
elif [[ $# -gt 0 && "$1" != -* ]]; then sub="$1"; shift; fi   # `dots -m msg` == `dots sync -m msg`
case "$sub" in
    sync) cmd_sync "$@" ;;
    status) cmd_status ;;
    apply) cmd_apply "$@" ;;
    add) cmd_add "$@" ;;
    help|-h|--help) sed -n '2,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) echo "unknown command: $sub (try: sync, status, apply, add)" >&2; exit 2 ;;
esac
