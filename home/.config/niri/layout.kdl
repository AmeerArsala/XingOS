layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring { off; }

    border {
        on
        width 2
        inactive-color "#4d4d4d5a"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// Keep Noctalia's wallpaper backdrop visible in the overview
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    XDG_DATA_DIRS "/home/isagi/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
}
