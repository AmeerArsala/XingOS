// Modular niri config (structure from shen-nm/niri-config, tweaks from nixxoq/dotfiles).
prefer-no-csd
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    // Fixes screenshare stream drops on Chromium/Electron apps
    force-pipewire-invalid-modifier
}

include "inputs.kdl"
include "outputs.kdl"
include "layout.kdl"
include "window-rules.kdl"
include "startup.kdl"
include "binds.kdl"
include "cursor.kdl"
// Generated by Noctalia's niri template; keep last so its colors win.
include "noctalia.kdl"
