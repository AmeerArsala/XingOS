// Modular niri config (structure from shen-nm/niri-config, tweaks from nixxoq/dotfiles).
prefer-no-csd
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    // Fixes screenshare stream drops on Chromium/Electron apps
    force-pipewire-invalid-modifier
}

include "inputs.kdl"
include "outputs.kdl"
include "layout.kdl"
include "window-rules.kdl"
include "startup.kdl"
include "binds.kdl"
// Escape-to-stop-dictation, armed only while recording (scripts/dictation.sh)
include "dictation.kdl"
include "cursor.kdl"
// Generated by Noctalia's niri template; keep last so its colors win.
include "noctalia.kdl"

binds {
    // >>> jcode launch hotkeys (managed) >>>
    Super+Semicolon hotkey-overlay-title="jcode: audiocall" { spawn "sh" "-c" "if [ \"$(niri msg -j focused-window 2>/dev/null | jq -r '.app_id // empty' 2>/dev/null)\" = 'jcode-desktop' ]; then exec wtype -M ctrl -M alt -k Return -m alt -m ctrl; fi; if [ -d '/home/isagi/Projects/audiocall' ]; then cd '/home/isagi/Projects/audiocall'; else cd \"$HOME\"; fi; exec 'alacritty' '/home/isagi/.jcode/builds/versions/0.99.1/jcode-linux-x86_64.bin' --spawn-hotkey 'cmd+;'"; }
    Super+Apostrophe hotkey-overlay-title="jcode: home" { spawn "sh" "-c" "if [ \"$(niri msg -j focused-window 2>/dev/null | jq -r '.app_id // empty' 2>/dev/null)\" = 'jcode-desktop' ]; then exec wtype -M ctrl -k t -m ctrl; fi; if [ -d '/home/isagi' ]; then cd '/home/isagi'; else cd \"$HOME\"; fi; exec 'alacritty' '/home/isagi/.jcode/builds/versions/0.99.1/jcode-linux-x86_64.bin' --spawn-hotkey 'cmd+'\\'''"; }
    Super+bracketleft hotkey-overlay-title="jcode: xcord" { spawn "sh" "-c" "if [ -d '/home/isagi/Projects/xcord' ]; then cd '/home/isagi/Projects/xcord'; else cd \"$HOME\"; fi; exec 'alacritty' '/home/isagi/.jcode/builds/versions/0.99.1/jcode-linux-x86_64.bin' --spawn-hotkey 'cmd+['"; }
    // <<< jcode launch hotkeys (managed) <<<
}
