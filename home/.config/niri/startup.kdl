spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=niri" "XDG_SESSION_DESKTOP=niri" "NIRI_SOCKET"
spawn-at-startup "xwayland-satellite"
// Bar, wallpaper, notifications, launcher and lockscreen
spawn-at-startup "noctalia"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "sh" "-c" "$HOME/.config/niri/scripts/dictation.sh disarm"
